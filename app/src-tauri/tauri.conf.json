{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EVE Chatterer",
  "version": "0.1.0",
  "identifier": "io.github.seraphx2.evechatterer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "license": "MIT",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/seraphx2/eve-chatterer/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3NjAwOTczNkVCMDBGODUKUldTRkQ3QnVjd2xnTjdIZ01YZ3hDS252cSs0eG1RL0VPaDFIRjhoU3BKSmRycWk1eTZMNXBWOVIK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
